
@'
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.streamlit/secrets.toml
.env

data/raw/*
data/processed/*
data/features/*

reports/*.csv
reports/*.parquet
reports/*.joblib
reports/*.pkl

!data/raw/.gitkeep
!data/processed/.gitkeep
!data/features/.gitkeep
'@ | Set-Content -Encoding utf8 .gitignore

New-Item -ItemType File -Force data\raw\.gitkeep
New-Item -ItemType File -Force data\processed\.gitkeep
New-Item -ItemType File -Force data\features\.gitkeep

git status
